---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
  label?: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="blog-toc">
    <aside class="toc-rail" data-toc-rail aria-label="Table of contents">
      <nav class="toc-rail-inner">
        <p class="toc-kicker">contents</p>
        <ol class="toc-list">
          {items.map((item, index) => (
            <li>
              <a class="toc-link" href={`#${item.slug}`} data-toc-link={item.slug}>
                <span class="toc-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="toc-label">{item.label ?? item.text}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="toc-top" href="#" data-toc-top>back to top</a>
      </nav>
    </aside>

    <button type="button" class="toc-pill" data-toc-pill aria-label="Open table of contents">
      <span>contents</span>
      <span class="toc-pill-count" data-toc-count>1/{items.length}</span>
    </button>

    <dialog class="toc-sheet" data-toc-sheet aria-label="Table of contents">
      <div class="toc-sheet-head">
        <p class="toc-kicker">contents</p>
        <button type="button" class="toc-sheet-close" data-toc-close aria-label="Close table of contents">
          &times;
        </button>
      </div>
      <nav aria-label="Article sections">
        <ol class="toc-list toc-list-sheet">
          {items.map((item, index) => (
            <li>
              <a class="toc-link" href={`#${item.slug}`} data-toc-link={item.slug}>
                <span class="toc-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="toc-label">{item.label ?? item.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </dialog>
  </div>
)}

<script>
  const rail = document.querySelector<HTMLElement>('[data-toc-rail]');
  const pill = document.querySelector<HTMLButtonElement>('[data-toc-pill]');
  const sheet = document.querySelector<HTMLDialogElement>('[data-toc-sheet]');

  if (rail && pill && sheet) {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const counts = [...document.querySelectorAll<HTMLElement>('[data-toc-count]')];
    const headings = [...document.querySelectorAll<HTMLElement>('.blog-post-content h2')];
    const sentinel = document.querySelector<HTMLElement>('[data-toc-sentinel]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let activeId = '';
    const setActive = (id: string) => {
      if (!id || id === activeId) return;
      activeId = id;
      links.forEach((link) => {
        if (link.dataset.tocLink === id) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
      const index = headings.findIndex((heading) => heading.id === id);
      counts.forEach((count) => {
        count.textContent = `${Math.max(1, index + 1)}/${headings.length}`;
      });
    };

    const updateActive = () => {
      const threshold = window.innerHeight * 0.4;
      let current = headings[0]?.id ?? '';
      headings.forEach((heading) => {
        if (heading.getBoundingClientRect().top <= threshold) current = heading.id;
      });
      setActive(current);
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActive();
        ticking = false;
      });
    }, { passive: true });
    window.addEventListener('resize', updateActive, { passive: true });
    updateActive();

    const setVisible = (visible: boolean) => {
      rail.classList.toggle('is-visible', visible);
      pill.classList.toggle('is-visible', visible);
    };

    if (sentinel) {
      const sentinelObserver = new IntersectionObserver(
        ([entry]) => setVisible(!entry.isIntersecting),
        { threshold: 0 }
      );
      sentinelObserver.observe(sentinel);
    } else {
      setVisible(true);
    }

    const openSheet = () => {
      document.body.style.overflow = 'hidden';
      sheet.showModal();
    };

    const closeSheet = () => sheet.close();

    pill.addEventListener('click', openSheet);
    sheet.querySelector<HTMLElement>('[data-toc-close]')?.addEventListener('click', closeSheet);

    sheet.addEventListener('click', (event) => {
      if (event.target === sheet) closeSheet();
    });

    sheet.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    sheet.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const id = link.getAttribute('href')?.slice(1);
        closeSheet();
        if (!id) return;
        document.getElementById(id)?.scrollIntoView({
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
        history.replaceState(null, '', `#${id}`);
      });
    });

    document.querySelector<HTMLAnchorElement>('[data-toc-top]')?.addEventListener('click', (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      history.replaceState(null, '', window.location.pathname);
    });

    window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
      if (event.matches && sheet.open) closeSheet();
    });
  }
</script>
