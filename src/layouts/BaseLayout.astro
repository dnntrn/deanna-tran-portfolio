---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Deanna Tran - Senior Product Engineer | Cloudflare",
  description = "Deanna Tran is a Senior Product Engineer at Cloudflare in NYC. Building developer tools, operational platforms, and expressive interfaces. Creator of Deckcraft."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Deanna Tran">
  
  <link rel="canonical" href="https://deannatran.com">
  
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content="https://deannatran.com">
  <meta property="og:site_name" content="Deanna Tran">
  
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <meta name="theme-color" content="#d3a4ff">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="font-sans bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-tertiary text-text-primary leading-relaxed text-base min-h-screen relative flex flex-col transition-colors duration-300">
  <div class="warmth-gradient fixed inset-0 pointer-events-none z-0 bg-gradient-to-b from-bg-primary via-bg-secondary to-bg-tertiary transition-colors duration-300"></div>
  <div class="noise-overlay fixed inset-0 pointer-events-none z-[1] opacity-10"></div>
  
  <header class="site-header flex justify-between items-center relative z-10 p-8 max-md:flex-wrap max-md:gap-4 max-md:p-6">
    <a href="/" class="site-logo inline-flex items-center no-underline transition-transform duration-300" aria-label="Deanna Tran - Home">
      <slot name="logo">
        <svg class="logo-left" viewBox="0 0 33 24" width="38" height="28" style="overflow: visible; flex-shrink: 0;">
          <defs>
            <linearGradient id="starGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#ec4899"/>
              <stop offset="33%" stop-color="#d946ef"/>
              <stop offset="66%" stop-color="#a855f7"/>
              <stop offset="100%" stop-color="#ec4899"/>
            </linearGradient>
            <filter id="starGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="2" result="blur1"/>
              <feGaussianBlur stdDeviation="4" result="blur2"/>
              <feMerge>
                <feMergeNode in="blur2"/>
                <feMergeNode in="blur1"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <path d="M8 4 L3 12 L8 20" fill="none" stroke="#7c3ead" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <g>
            <path class="logo-star" d="M16 6 Q 16 12 22 12 Q 16 12 16 18 Q 16 12 10 12 Q 16 12 16 6 Z" fill="url(#starGradient)" filter="url(#starGlow)"/>
            <path class="logo-star-small" d="M26 3 Q 26 8 31 8 Q 26 8 26 13 Q 26 8 21 8 Q 26 8 26 3 Z" fill="url(#starGradient)" filter="url(#starGlow)"/>
          </g>
        </svg>
        <svg class="logo-right" viewBox="0 0 24 24" width="28" height="28" style="overflow: visible; flex-shrink: 0;">
          <path d="M4 20 L8 4" fill="none" stroke="#7c3ead" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M13 4 L18 12 L13 20" fill="none" stroke="#7c3ead" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </slot>
    </a>
    
    <nav class="flex items-center gap-8 max-md:gap-6" aria-label="Main navigation">
      <a href="/projects" class="nav-link text-sm font-medium text-text-secondary no-underline max-md:text-[0.8125rem]">Projects</a>
      <a href="#" class="nav-link text-sm font-medium text-text-secondary no-underline max-md:text-[0.8125rem]">Resume</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href="https://github.com/dnntrn" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-transparent border-none cursor-pointer text-text-secondary transition-all duration-300 hover:text-accent hover:scale-[1.15] hover:-translate-y-0.5 hover:bg-tag-bg" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/deannatran/" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-transparent border-none cursor-pointer text-text-secondary transition-all duration-300 hover:text-accent hover:scale-[1.15] hover:-translate-y-0.5 hover:bg-tag-bg" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <button class="theme-toggle bg-transparent border-none cursor-pointer text-text-secondary p-2 rounded-full transition-all duration-300 flex items-center justify-center hover:text-accent hover:bg-tag-bg" aria-label="Toggle dark mode" title="Toggle dark/light mode">
      <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" style="display: block;">
        <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" style="display: none;">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    </div>
  </header>

  <div id="ascii-cat" class="ascii-cat hidden">
    <div class="cat-container-inner relative inline-block mr-[120px]">
      <pre class="cat-face font-mono text-sm leading-tight text-text-primary cursor-pointer select-none">{` /\\_/\\
( o.o )
 > ^ <`}</pre>
      <div class="cat-crown absolute -top-[18px] left-1/2 -translate-x-1/2 scale-0 text-2xl leading-none opacity-0 drop-shadow-[0_2px_4px_rgba(255,215,0,0.3)] z-[2] pointer-events-none">👑</div>
    </div>
    <div class="cat-speech font-sans text-xs text-text-secondary bg-speech-bg px-4 py-2 rounded-[20px] shadow-[0_2px_10px_rgba(0,0,0,0.1)] opacity-0 absolute right-full top-1/2 -translate-y-1/2 translate-x-[10px] mr-2.5 whitespace-nowrap z-10">purr</div>
  </div>

  <main class="mx-auto p-8 relative z-10 flex-1 w-full max-md:p-6" role="main">
    <slot />
  </main>

  <footer class="site-footer mx-auto px-8 pt-12 pb-8 flex justify-between items-center border-t border-border relative z-10 max-md:flex-col max-md:gap-4 max-md:text-center max-md:px-6 max-md:pt-8 max-md:pb-6">
    <button class="social-link sparkle-btn inline-flex items-center justify-center w-9 h-9 rounded-full bg-transparent border-none cursor-pointer text-text-secondary transition-all duration-300 hover:text-accent hover:scale-[1.15] hover:-translate-y-0.5 hover:bg-tag-bg" aria-label="Secret" title="Sparkle">
      <svg viewBox="0 0 36 24" width="28" height="20" style="display: block; overflow: visible;">
        <path d="M14 4 Q 14 10 20 10 Q 14 10 14 16 Q 14 10 8 10 Q 14 10 14 4 Z" fill="#ec4899" filter="url(#starGlow)"/>
        <path d="M26 2 Q 26 6 30 6 Q 26 6 26 10 Q 26 6 22 6 Q 26 6 26 2 Z" fill="#a855f7" filter="url(#starGlow)"/>
      </svg>
    </button>
    <p class="text-sm text-text-secondary">© 2026 deanna</p>
  </footer>

  <script is:inline src="/scripts/darkMode.js"></script>
  <script is:inline src="/scripts/asciiCat.js"></script>
  <script is:inline src="/scripts/sparkleBurst.js"></script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "@id": "https://deannatran.com/#person",
      "name": "Deanna Tran",
      "jobTitle": "Senior Product Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Cloudflare",
        "url": "https://cloudflare.com"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "New York",
        "addressRegion": "NY",
        "addressCountry": "US"
      },
      "url": "https://deannatran.com",
      "sameAs": [
        "https://github.com/dnntrn",
        "https://www.linkedin.com/in/deannatran/"
      ],
      "knowsAbout": [
        "React",
        "TypeScript",
        "Cloudflare Workers",
        "Product Engineering",
        "Developer Tools",
        "Full-Stack Development",
        "UI/UX Design",
        "Serverless Architecture",
        "Design Systems"
      ]
    }
  }
  </script>
</body>
</html>
