---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogToc from '../../components/BlogToc.astro';
import SocialShare from '../../components/SocialShare.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocItems = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({
    ...heading,
    label: post.data.toc?.[heading.slug] ?? heading.text,
  }));

const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout 
  title={`${post.data.title} | Deanna Tran`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <div class="blog-reading-layout">
    <BlogToc items={tocItems} />
    <article class="blog-article">
    <header class="mb-8" data-toc-sentinel>
      <a href="/blog" class="inline-block text-sm text-text-secondary no-underline mb-4 transition-colors duration-300 hover:text-accent">&larr; Back to posts</a>
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <time datetime={post.data.pubDate.toISOString()} class="text-sm text-text-muted">
          {post.data.pubDate.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric',
            timeZone: 'UTC'
          })}
        </time>
        <SocialShare url={articleUrl} title={post.data.title} text={post.data.description} inline />
      </div>
      <h1 class="text-3xl font-semibold text-text-primary mb-0">{post.data.title}</h1>
      <p class="blog-dek">{post.data.description}</p>
    </header>
    
    <div class="leading-relaxed blog-post-content">
      <Content />
    </div>
  </article>
  </div>
</BaseLayout>
