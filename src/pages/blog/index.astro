---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const externalPosts = [
  {
    title: 'Building an evidence-grounded agentic security operations harness on Cloudflare',
    description:
      'Cloudflare Managed Defense uses a team of specialized AI agents built on Workers and global network telemetry to analyze security alerts. By separating deterministic evidence collection from model inference, the system delivers grounded recommendations to Managed Defense Analysts.',
    href: 'https://blog.cloudflare.com/agentic-security-operations/',
    pubDate: new Date('2026-10-07T16:30:36.761Z'),
    external: true,
    source: 'Cloudflare Blog',
  },
];

const entries = [
  ...posts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    href: `/blog/${post.id.replace(/\.mdx?$/, '')}`,
    pubDate: post.data.pubDate,
    external: false,
    source: null,
  })),
  ...externalPosts,
]
  .sort((a, b) => a.pubDate.getTime() - b.pubDate.getTime())
  .map((entry, index) => ({ ...entry, number: index + 1 }))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());
---

<BaseLayout
  title="Blog | Deanna Tran"
  description="Blog posts by Deanna Tran, Senior Software Engineer at Cloudflare. Thoughts on engineering, product, and tinkering."
>
  <section class="max-w-[640px] mx-auto">
    <h1 class="sr-only">Blog</h1>

    {entries.map((entry) => {
      const date = entry.pubDate.toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });
      return (
        <article class="mb-12 last:mb-0">
          <div class="flex items-start gap-4 mb-2">
            <span class="pt-1 text-sm text-text-muted font-medium tabular-nums">
              {String(entry.number).padStart(2, '0')}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                <h2 class="project-title blog-entry-title min-w-0 text-xl font-semibold">
                  <a
                    href={entry.href}
                    class="text-text-primary no-underline inline-flex items-center gap-2"
                    target={entry.external ? '_blank' : undefined}
                    rel={entry.external ? 'noopener noreferrer' : undefined}
                  >
                    {entry.title}
                    {entry.external && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </h2>
                <div class="flex shrink-0 flex-wrap items-center gap-2 self-start md:mt-0.5">
                  {entry.source && (
                    <span class="inline-flex items-center rounded-full border border-border bg-bg-secondary px-2 py-0.5 text-[0.6875rem] font-semibold text-text-secondary">
                      {entry.source} ↗
                    </span>
                  )}
                  <time
                    datetime={entry.pubDate.toISOString()}
                    class="inline-flex shrink-0 items-center whitespace-nowrap text-[0.6875rem] font-semibold text-accent bg-tag-bg px-2 py-0.5 rounded border border-accent/20"
                  >
                    {date}
                  </time>
                </div>
              </div>
            </div>
          </div>
          <p class="text-text-secondary text-base leading-relaxed ml-10">
            {entry.description}
          </p>
        </article>
      );
    })}
  </section>
</BaseLayout>
