---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Deanna Tran - Senior Software Engineer | Cloudflare"
  description="Deanna Tran is a Senior Software Engineer at Cloudflare in NYC, operating like an internal forward-deployed engineer or product engineer across security and trust. She focuses on fixing underlying workflows and thrives in high-ambiguity loops."
>
  <section class="intro mb-16 relative flex items-stretch gap-8 justify-center max-md:flex-col max-md:items-center">
    <!-- Mobile: bust shot image -->
    <img src="/stars_bust.svg" alt="Deanna Tran" class="profile-avatar-mobile block md:hidden w-[260px] mx-auto mb-4">

    <div class="text-column max-w-[500px] flex-1 flex flex-col max-md:max-w-full">
      <h1 class="greeting flex flex-wrap items-center gap-2 text-5xl font-semibold mb-6 text-text-primary max-md:text-3xl">
        <span class="greeting-prefix font-normal">hi! i'm</span>
        <span class="name-logo inline-flex items-center gap-1">
          <span class="name-text">deanna</span>
        </span>
      </h1>

      <p class="typewriter-paragraph mb-5">
        <span class="typewriter-target">i live in Queens, NYC</span>
        <span class="typewriter-label"> with an assertive cat and my wonderful partner.</span>
      </p>

      <p class="typewriter-paragraph mb-5">
        <span class="typewriter-target">i'm a senior software engineer</span>
        <span class="typewriter-label"> at cloudflare. The best way to describe my role is like an internal forward-deployed engineer or product engineer across our security and trust organization.</span>
      </p>

      <p class="typewriter-paragraph mb-5">
        <span class="typewriter-target">i focus on fixing underlying workflows instead of just digitizing broken ones</span>
        <span class="typewriter-label"> by dropping into teams to map the customer problem, define the technical roadmap, and ship.</span>
      </p>

      <p class="fade-paragraph mb-5">before cloudflare, i was at early-stage startups spinning up design systems and pivoting lots.</p>

      <p class="typewriter-paragraph mb-5">
        <span class="typewriter-label">outside of work, I love tinkering on random things and watching basketball.</span>
        <span class="typewriter-target">i love my cat, lion</span><span class="typewriter-label">.</span>
      </p>
    </div>
    
    <!-- Desktop: portrait stage with stars and cat -->
    <div class="portrait-stage hidden md:block">
      <div class="portrait-ground" aria-hidden="true"></div>
      <img src="/full_body_wave.svg" alt="Deanna Tran" class="portrait-figure">
      <img src="/cat_playing.svg" alt="Lion the cat playing with a ball" class="portrait-cat">

      <svg class="hero-stars" viewBox="0 0 350 760" aria-hidden="true">
        <defs>
          <linearGradient id="heroStarGradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e8a5c0" />
            <stop offset="1" stop-color="#d3a4ff" />
          </linearGradient>
        </defs>
        <g class="hero-star" transform="translate(24 52) scale(1.1)" style="animation-delay: -0.6s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(306 28) scale(0.8)" style="animation-delay: -1.8s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(-8 300) scale(0.85)" style="animation-delay: -2.4s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(330 260) scale(0.65)" style="animation-delay: -0.9s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(20 540) scale(0.75)" style="animation-delay: -1.3s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(324 560) scale(0.95)" style="animation-delay: -2.1s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(290 120) scale(0.5)" style="animation-delay: -0.3s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
        <g class="hero-star" transform="translate(0 700) scale(0.7)" style="animation-delay: -1.5s">
          <path d="M12 0 Q12 12 24 12 Q12 12 12 24 Q12 12 0 12 Q12 12 12 0Z" fill="url(#heroStarGradient)" />
        </g>
      </svg>
    </div>
  </section>

  <script is:inline src="/scripts/staggeredFade.js"></script>
</BaseLayout>
