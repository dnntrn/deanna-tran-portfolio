---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Resume | Deanna Tran"
  description="Resume of Deanna Tran, Senior Product Engineer at Cloudflare. Experience in product engineering, design systems, and full-stack development."
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "Deanna Tran",
      "jobTitle": "Senior Product Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Cloudflare",
        "url": "https://cloudflare.com"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "New York",
        "addressRegion": "NY",
        "addressCountry": "US"
      },
      "email": "itsdeannatran@gmail.com",
      "url": "https://deannatran.com",
      "sameAs": [
        "https://github.com/dnntrn",
        "https://www.linkedin.com/in/deannatran/"
      ],
      "knowsAbout": [
        "React",
        "TypeScript",
        "Cloudflare Workers",
        "TailwindCSS",
        "Product Engineering",
        "Design Systems",
        "Cross-Functional Collaboration"
      ],
      "alumniOf": {
        "@type": "Organization",
        "name": "New York University"
      },
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Senior Product Engineer",
        "occupationLocation": {
          "@type": "City",
          "name": "New York, NY"
        }
      }
    }
  }
  </script>

  <article class="max-w-[850px] mx-auto md:my-8 resume-lowercase">
    <div class="bg-white rounded-none shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-8 md:p-10 max-md:mx-4 max-md:p-6 resume-paper">
      
      <!-- Header: Name + Contact + Download -->
      <header class="mb-6 flex justify-between items-start">
        <div>
          <h1 class="text-2xl font-semibold mb-0.5 text-[#1a1a2e]">Deanna Tran</h1>
          <p class="text-sm"><span class="text-resume-accent">Senior Product Engineer,</span> <span class="text-xs text-[#6a6a7a]">new york, ny</span></p>
          
          <address class="flex flex-wrap gap-x-2 gap-y-0.5 text-xs text-[#6a6a7a] not-italic">
            <a href="mailto:itsdeannatran@gmail.com" class="hover:text-resume-accent transition-colors">itsdeannatran@gmail.com</a>
            <span>·</span>
            <a href="https://linkedin.com/in/deannatran" class="hover:text-resume-accent transition-colors" target="_blank" rel="noopener">linkedin.com/in/deannatran</a>
            <span>·</span>
            <a href="https://github.com/dnntrn" class="hover:text-resume-accent transition-colors" target="_blank" rel="noopener">github.com/dnntrn</a>
          </address>
        </div>
        <a href="/deanna tran.pdf" download="deanna tran.pdf" class="print:hidden flex items-center gap-1.5 text-xs font-medium text-resume-accent border border-resume-accent/30 hover:bg-resume-accent/10 hover:border-resume-accent/50 transition-colors px-3 py-1.5 rounded" aria-label="Download resume as PDF">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          download pdf
        </a>
      </header>

      <!-- Experience -->
      <section class="mb-5" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="text-[0.65rem] font-semibold uppercase tracking-widest text-[#9a9aaa] mb-4 border-b border-[rgba(0,0,0,0.08)] pb-1">Experience</h2>
        
        <!-- Cloudflare (grouped) -->
        <section class="mb-4">
          <header class="flex justify-between items-start mb-2">
            <div>
              <h3 class="text-sm font-semibold text-[#1a1a2e]"><a href="https://cloudflare.com" class="no-underline hover:text-resume-accent transition-colors" target="_blank" rel="noopener noreferrer">Cloudflare</a></h3>
              <p class="text-xs text-[#9a9aaa]">security operations, trust and safety</p>
            </div>
            <span class="text-xs text-[#9a9aaa] mt-0.5">May 2024 – Present</span>
          </header>
          
          <div class="mb-1 pb-3">
            <p class="text-xs font-medium text-resume-accent mb-1">Senior Software Engineer</p>
            <ul class="list-disc list-outside ml-4 text-[#333344] text-xs space-y-0.5">
              <!-- <li>Operate as an internal forward-deployed engineer to jump between teams as needed, redefining broken processes before building fullstack systems so it enforces better workflows</li>
              <li>Rebuild the operational platform behind Cloudflare's SOC-as-a-service leading to significantly less manual management and a better foundation for automation</li>
              <li>Define and own product roadmaps and delivery dates</li>
              <li>Mentor junior engineers and interns leading to an increase in overall team speed</li>
              <li>Coaching non-technical stakeholders on leveraging AI for research and operational workflows</li> -->
              <li><strong>Forward-Deployed:</strong> Embedded across security and trust teams to diagnose broken operational processes and build full-stack solutions</li>
              <li><strong>0-to-1 Build:</strong> Architect and ship the operational platform behind Cloudflare’s SOC-as-a-service, replacing manual tasks</li>
              <li><strong>Product Ownership:</strong> Define product roadmaps, scope requirements, and own cross-functional delivery dates</li>
              <li><strong>Mentorship:</strong> Mentor junior engineers and interns to ramp up code quality and increase overall team shipping speed</li>
              <li><strong>AI Workflows:</strong> Train non-technical enterprise stakeholders on leveraging AI tools to accelerate research and documentation</li>
            </ul>
          </div>
          
          <div>
            <p class="text-xs font-medium text-resume-accent mb-1">Software Engineer</p>
            <ul class="list-disc list-outside ml-4 text-[#333344] text-xs space-y-0.5">
              <li><strong>Operational Impact:</strong> Reduced legal response processing times by 80–90% and completely eliminated engineering overhead for routine requests</li>
              <li><strong>Self-Serve UIs:</strong> Built a metadata-driven UI framework that allows Trust & Safety analysts to self-serve, defining their own templates and workflows without code changes</li>
              <li><strong>Product Ownership:</strong> Served as primary frontend owner for all Legal Response UIs, building internal applications for geoblocks, PRTT processing, and data preservation from scratch</li>
            </ul>
          </div>
        </section>
        
        <!-- Season -->
        <section class="mb-4">
          <header class="flex justify-between items-start mb-2">
            <div>
              <h3 class="text-sm font-semibold text-[#1a1a2e]"><a href="https://seasonhealth.com" class="no-underline hover:text-resume-accent transition-colors" target="_blank" rel="noopener noreferrer">Season</a></h3>
              <p class="text-xs text-[#9a9aaa]">healthtech, nutrition, Series A</p>
            </div>
            <time class="text-xs text-[#9a9aaa] mt-0.5" datetime="2022-07">Jul 2022 – Nov 2023</time>
          </header>
          <p class="text-xs font-medium text-resume-accent mb-1">Frontend Engineer</p>
          <ul class="list-disc list-outside ml-4 text-[#333344] text-xs space-y-0.5">
            <!-- <li>Delivered patient-facing cart checkout, intake forms, and third-party vendor storefront</li>
            <li>Created internal design system with reusable components, increasing team dev speed</li>
            <li>Fixed and triaged production bugs appropiately during on-call rotations</li> -->
            <li><strong>Greenfield Delivery:</strong> Engineered and shipped critical patient-facing infrastructure, including the cart checkout flow, intake forms, and third-party vendor storefront</li>
            <li><strong>Design System:</strong> Created an internal design system with reusable components, drastically accelerating team development velocity and reducing visual debt</li>
            <li><strong>On-Call Responsibility:</strong> Triaged and resolved high-priority production bugs during on-call rotations to maintain platform uptime</li>
          </ul>
        </section>
        
        <!-- Ellevest -->
        <section>
          <header class="flex justify-between items-start mb-2">
            <div>
              <h3 class="text-sm font-semibold text-[#1a1a2e]"><a href="https://ellevest.com" class="no-underline hover:text-resume-accent transition-colors" target="_blank" rel="noopener noreferrer">Ellevest</a></h3>
              <p class="text-xs text-[#9a9aaa]">fintech, Series B</p>
            </div>
            <span class="text-xs text-[#9a9aaa] mt-0.5">Sep 2019 – Jun 2022</span>
          </header>
          
          <div class="mb-3 pb-3">
            <p class="text-xs font-medium text-resume-accent mb-1">Software Engineer II</p>
            <ul class="list-disc list-outside ml-4 text-[#333344] text-xs space-y-0.5">
              <!-- <li>Developed core mobile + web features resulting in 4% conversion increase and 20% funding rate increase (React and React Native)</li>
              <li>Debugged and fixed production application issues reported through bug reports and client support requests</li>
              <li>Wrote end-to-end tests for our mobile app and website using WebdriverIO</li> -->
              <li><strong>Onboarding and Conversion:</strong> Developed core full-stack features using React and React Native, driving a 4% increase in conversion and a 20% increase in funding rate</li>
              <li><strong>Production Support:</strong> Debugged and resolved complex application issues escalated through client support and automated bug reports</li>
              <li><strong>Test Automation:</strong> Authored comprehensive end-to-end mobile and web automation test suites using WebdriverIO to guarantee release stability</li>
            </ul>
          </div>
        </section>
      </section>

      <!-- Skills -->
      <section class="mb-5" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="text-[0.65rem] font-semibold uppercase tracking-widest text-[#9a9aaa] mb-2 border-b border-[rgba(0,0,0,0.08)] pb-1">Skills</h2>
        <div class="flex flex-wrap gap-2">
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">React</span>
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">TypeScript</span>
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">Cloudflare Workers</span>
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">TailwindCSS</span>
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">Product Engineering</span>
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">Design Systems</span>
          <span class="text-xs text-[#333344] bg-[rgba(0,0,0,0.04)] px-2 py-1 rounded">Cross-Functional Collaboration</span>
        </div>
      </section>

      <!-- Education -->
      <section aria-labelledby="education-heading">
        <h2 id="education-heading" class="text-[0.65rem] font-semibold uppercase tracking-widest text-[#9a9aaa] mb-2 border-b border-[rgba(0,0,0,0.08)] pb-1">Education</h2>
        <div class="flex justify-between items-baseline mb-0.5">
          <p class="text-xs text-[#333344]"><span><strong>New York University</strong>,</span> BA Computer Science</p>
          <span class="text-xs text-[#9a9aaa]">2020</span>
        </div>
        
      </section>
    </div>
  </article>
</BaseLayout>
