---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Resume | Deanna Tran"
  description="Resume of Deanna Tran, Senior Product Engineer at Cloudflare. Experience in product engineering, design systems, and full-stack development."
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "Deanna Tran",
      "jobTitle": "Senior Product Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Cloudflare",
        "url": "https://cloudflare.com"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "New York",
        "addressRegion": "NY",
        "addressCountry": "US"
      },
      "email": "itsdeannatran@gmail.com",
      "telephone": "856-405-7989",
      "url": "https://deannatran.com",
      "sameAs": [
        "https://github.com/dnntrn",
        "https://www.linkedin.com/in/deannatran/"
      ],
      "knowsAbout": [
        "React",
        "TypeScript",
        "Cloudflare Workers",
        "TailwindCSS",
        "Product Engineering",
        "Design Systems",
        "Cross-Functional Collaboration"
      ],
      "alumniOf": {
        "@type": "Organization",
        "name": "New York University"
      },
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Senior Product Engineer",
        "occupationLocation": {
          "@type": "City",
          "name": "New York, NY"
        }
      }
    }
  }
  </script>

  <article class="max-w-[800px] mx-auto md:my-8 resume-lowercase">
    <div class="bg-white rounded-none shadow-[0_4px_30px_rgba(0,0,0,0.08)] p-8 md:p-12 max-md:mx-4 max-md:p-6 resume-paper">
      
      <!-- Header: Name + Contact -->
      <header class="mb-6">
        <h1 class="text-3xl font-semibold mb-1 text-[#1a1a2e] max-md:text-2xl">Deanna Tran</h1>
        <p class="text-base text-[#a855f7] mb-3">Senior Product Engineer</p>
        
        <address class="flex flex-wrap gap-x-3 gap-y-0.5 text-sm text-[#6a6a7a] not-italic max-md:justify-center">
          <span>New York, NY</span>
          <span>·</span>
          <a href="mailto:itsdeannatran@gmail.com" class="hover:text-[#a855f7] transition-colors">itsdeannatran@gmail.com</a>
          <span>·</span>
          <span>856-405-7989</span>
          <span>·</span>
          <a href="https://linkedin.com/in/deannatran" class="hover:text-[#a855f7] transition-colors" target="_blank" rel="noopener">linkedin.com/in/deannatran</a>
          <span>·</span>
          <a href="https://github.com/dnntrn" class="hover:text-[#a855f7] transition-colors" target="_blank" rel="noopener">github.com/dnntrn</a>
        </address>
      </header>

      <!-- Experience -->
      <section class="mb-6" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="text-[0.7rem] font-semibold uppercase tracking-widest text-[#9a9aaa] mb-3">Experience</h2>
        
        <!-- Cloudflare (grouped) -->
        <section class="mb-4">
          <header class="flex justify-between items-baseline mb-2 max-md:flex-col max-md:gap-0">
            <h3 class="text-base font-semibold text-[#1a1a2e]">Cloudflare</h3>
            <span class="text-xs text-[#9a9aaa]">May 2024 – Present</span>
          </header>
          
          <div class="mb-3">
            <p class="text-xs text-[#a855f7] mb-0.5">Senior Software Engineer <span class="text-[#9a9aaa]">— Apr 2026 – Present</span></p>
            <ul class="list-disc list-inside text-[#6a6a7a] text-sm space-y-0.5">
              <li>Rebuilding the operational platform behind SOC-as-a-service: redefining broken processes before building the system so it enforces better workflows</li>
              <li>Shifting engineering culture from "build what's requested" to "understand the user problem first"</li>
              <li>Coaching non-technical stakeholders on leveraging AI for research and operational workflows</li>
            </ul>
          </div>
          
          <div>
            <p class="text-xs text-[#a855f7] mb-0.5">Software Engineer <span class="text-[#9a9aaa]">— May 2024 – Apr 2026</span></p>
            <ul class="list-disc list-inside text-[#6a6a7a] text-sm space-y-0.5">
              <li>Reduced legal response processing time by 80-90% and eliminated engineering involvement in routine requests</li>
              <li>Built a metadata-driven UI framework where T&S analysts self-serve adjust their own workflows</li>
              <li>Primary frontend owner for all Legal Response UIs: geoblock, PRTT, preservation tooling</li>
            </ul>
          </div>
        </section>
        
        <!-- Season -->
        <section class="mb-4">
          <header class="flex justify-between items-baseline mb-0.5 max-md:flex-col max-md:gap-0">
            <h3 class="text-base font-semibold text-[#1a1a2e]">Season</h3>
            <time class="text-xs text-[#9a9aaa]" datetime="2022-07">Jul 2022 – Nov 2023</time>
          </header>
          <p class="text-xs text-[#a855f7] mb-1">Frontend Engineer</p>
          <ul class="list-disc list-inside text-[#6a6a7a] text-sm space-y-0.5">
            <li>Delivered patient-facing cart checkout, intake forms, and third-party vendor storefront</li>
            <li>Created internal design system with reusable components, increasing team dev speed</li>
          </ul>
        </section>
        
        <!-- Ellevest (grouped) -->
        <section class="mb-4">
          <header class="flex justify-between items-baseline mb-2 max-md:flex-col max-md:gap-0">
            <h3 class="text-base font-semibold text-[#1a1a2e]">Ellevest</h3>
            <span class="text-xs text-[#9a9aaa]">Sep 2019 – Jun 2022</span>
          </header>
          
          <div class="mb-3">
            <p class="text-xs text-[#a855f7] mb-0.5">Software Engineer II <span class="text-[#9a9aaa]">— Jul 2021 – Jun 2022</span></p>
            <ul class="list-disc list-inside text-[#6a6a7a] text-sm space-y-0.5">
              <li>Developed core mobile + web features resulting in 4% conversion increase and 20% funding rate increase</li>
              <li>Planned and led a maintenance sprint reducing tech debt and increasing cross-team collaboration</li>
            </ul>
          </div>
          
          <div>
            <p class="text-xs text-[#a855f7] mb-0.5">Software Engineer I <span class="text-[#9a9aaa]">— Jul 2020 – Jul 2021</span></p>
            <ul class="list-disc list-inside text-[#6a6a7a] text-sm space-y-0.5">
              <li>Promoted from intern to full-time; contributed production React Native code to iOS app</li>
            </ul>
          </div>
        </section>
        
      </section>

      <!-- Skills -->
      <section class="mb-6" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="text-[0.7rem] font-semibold uppercase tracking-widest text-[#9a9aaa] mb-2">Skills</h2>
        <p class="text-sm text-[#6a6a7a]">React, TypeScript, Cloudflare Workers, TailwindCSS, Product Engineering, Design Systems, Cross-Functional Collaboration</p>
      </section>

      <!-- Education -->
      <section class="border-t border-[rgba(0,0,0,0.08)] pt-4" aria-labelledby="education-heading">
        <h2 id="education-heading" class="text-[0.7rem] font-semibold uppercase tracking-widest text-[#9a9aaa] mb-2">Education</h2>
        <p class="text-sm text-[#6a6a7a]">BA Computer Science, New York University, 2020. Minors: Web Design and Linguistics.</p>
      </section>
    </div>
  </article>
</BaseLayout>
