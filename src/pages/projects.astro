---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Projects | Deanna Tran"
  description="Projects by Deanna Tran, Senior Product Engineer at Cloudflare. Creator of Deckcraft and other developer tools."
>
  <section class="max-w-[640px] mx-auto">
    <article class="mb-12">
      <div class="flex items-center gap-4 mb-2">
        <span class="text-sm text-text-muted font-medium tabular-nums">01</span>
        <h2 class="project-title text-xl font-semibold">
          <a href="https://github.com/dnntrn/deckcraft" target="_blank" rel="noopener noreferrer" class="text-text-primary no-underline inline-flex items-center gap-2">deckcraft</a>
        </h2>
        <span class="inline-flex items-center text-[0.6875rem] font-semibold text-accent bg-tag-bg px-2 py-0.5 rounded border border-accent/20">wip</span>
      </div>
      <p class="text-text-secondary text-base leading-relaxed ml-10">
        an ai skill that crafts slides geared toward developers. edit code per slide and export to pptx via images.
      </p>
    </article>
  </section>
</BaseLayout>
