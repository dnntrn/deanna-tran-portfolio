---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Projects | Deanna Tran"
  description="Projects by Deanna Tran, Senior Product Engineer at Cloudflare. Creator of Deckcraft and other developer tools."
>
  <section class="mt-16">
    <h1 class="text-2xl font-semibold mb-6 text-text-primary">projects</h1>
    <p class="text-base mb-8 -mt-2 text-text-secondary">things i've built and experiments i'm tinkering with.</p>
    
    <article class="py-6 border-t border-border">
      <div class="flex items-center gap-3 mb-3">
        <div class="shrink-0">
          <svg class="logo-project" viewBox="0 0 57 24" width="28" height="12" style="overflow: visible;">
            <defs>
              <linearGradient id="starGradientSmall" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#e8a5c0"/>
                <stop offset="33%" stop-color="#f4c2a1"/>
                <stop offset="66%" stop-color="#d4a5e8"/>
                <stop offset="100%" stop-color="#e8a5c0"/>
              </linearGradient>
            </defs>
            <path d="M8 4 L3 12 L8 20" fill="none" stroke="#d3a4ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 6 Q 16 12 22 12 Q 16 12 16 18 Q 16 12 10 12 Q 16 12 16 6 Z" fill="url(#starGradientSmall)"/>
            <path d="M26 3 Q 26 8 31 8 Q 26 8 26 13 Q 26 8 21 8 Q 26 8 26 3 Z" fill="url(#starGradientSmall)"/>
            <path d="M4 20 L8 4" fill="none" stroke="#d3a4ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(26, 0)"/>
            <path d="M13 4 L18 12 L13 20" fill="none" stroke="#d3a4ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(26, 0)"/>
          </svg>
        </div>
        <h2 class="project-title text-xl font-semibold">
          <a href="https://github.com/dnntrn/deckcraft" target="_blank" rel="noopener noreferrer" class="text-text-primary no-underline inline-flex items-center gap-2">deckcraft</a>
        </h2>
      </div>
      <p class="text-text-secondary mb-3 text-base">an ai skill that crafts slides geared toward developers. edit code per slide and export to pptx via images.</p>
      <div class="flex gap-2 flex-wrap">
        <span class="tag text-[0.8125rem] text-text-secondary bg-tag-bg px-2.5 py-1 rounded cursor-default">ai</span>
        <span class="tag text-[0.8125rem] text-text-secondary bg-tag-bg px-2.5 py-1 rounded cursor-default">pptx</span>
        <span class="tag text-[0.8125rem] text-text-secondary bg-tag-bg px-2.5 py-1 rounded cursor-default">developer tools</span>
      </div>
    </article>
  </section>
</BaseLayout>
